# ProteOS guest sshd — the Kubernetes backend's variant, installed to
# /etc/ssh/sshd_config by image/guest.Dockerfile.
#
# Same contract as image/sshd_config (the ext4 image's): this sshd is NOT
# reachable from any network. It binds loopback only, and the ONLY path to it is
# the guest agent's inbound-SSH forward (tcp:1027 -> 127.0.0.1:22, see
# guestagent/internal/sshfwd), which the node-agent tunnel reaches on
# agentapi.GuestSSHPort and the control-plane gateway authenticates.
#
# Loopback is what makes that the sole path here too, and it is stronger than it
# looks: sshd runs as a SIDECAR CONTAINER in the machine pod, and containers in
# a pod share one network namespace — so 127.0.0.1 is the pod, and nothing else
# in the cluster can reach this port even before NetworkPolicy is considered.
#
# Two things differ from the ext4 config, both because there is no systemd:
#   * Host keys live on the persistent volume directly (the ext4 image symlinks
#     /etc/ssh onto its disk from the guest agent). /usr/local/bin/proteos-sshd
#     creates any that are missing before exec'ing sshd, which is the job
#     ssh-keygen -A did from the sshd unit's ExecStartPre.
#   * No `Include /etc/ssh/sshd_config.d/*.conf` — same reason as the ext4
#     config: nothing else is entitled to widen this file's policy.

Port 22
ListenAddress 127.0.0.1
AddressFamily inet

# Written by proteos-sshd on first start and kept on the machine's own volume,
# so the fingerprint an ssh client pins survives stop/start. A brand-new machine
# gets a fresh identity, by design.
HostKey /persist/ssh_host_keys/ssh_host_ed25519_key
HostKey /persist/ssh_host_keys/ssh_host_ecdsa_key
HostKey /persist/ssh_host_keys/ssh_host_rsa_key

# Keys only. The control plane injects the user's registered public keys as
# ~/.ssh/authorized_keys (replace-all on every push — see
# controlplane/internal/injector), so a revoked key stops working on the next
# push. The path is relative to the account's home, which is why the `dev` user's
# home in this image is the PERSISTED one (/persist/home, see guest.Dockerfile):
# sshd and the guest agent have to mean the same directory by "~", or the keys
# land somewhere sshd never looks.
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no

# UsePAM yes, exactly as in the ext4 image, and NOT because PAM is wanted: with
# UsePAM no, sshd does its own locked-account check and refuses every login —
# public-key included — for an account whose shadow password starts with "!".
# That is every account `useradd` creates without a password, which is the only
# kind this image has. PAM's account stack asks the right question instead
# (is the account expired or disabled?) rather than reading a locked password as
# a locked account. guest.Dockerfile makes pam_loginuid optional for the same
# reason it is optional everywhere in a container: there is no audit session to
# join.
UsePAM yes
# Sessions land as the unprivileged run-as user ('dev'); an image built without
# one falls back to root, which stays key-only.
PermitRootLogin prohibit-password

# No forwarding of any kind. Port forwarding through sshd would be a second,
# unaudited egress path around the machine's NetworkPolicy (and port preview
# already covers the legitimate "reach my dev server" case).
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
GatewayPorts no
PermitTunnel no
X11Forwarding no

# scp/sftp over the same forward.
Subsystem sftp /usr/lib/openssh/sftp-server

LoginGraceTime 30
MaxAuthTries 3
MaxSessions 10
MaxStartups 10:30:60
ClientAliveInterval 30
ClientAliveCountMax 4
PrintMotd no
AcceptEnv LANG LC_*
