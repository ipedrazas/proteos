# Control-plane settings (the non-secret half; the secret half is the Secret
# proteos-controlplane — see README.md). Names and meanings are exactly
# deploy/app-stack/compose.yaml's, so that file's comments apply here too.
PROTEOS_ADDR=:8080
PROTEOS_LOG_LEVEL=info

# The browser-facing origin: the URL users open, and the host+port in the IdP's
# and GitHub App's callback URLs. Override it in your overlay.
PROTEOS_BASE_URL=http://proteos.example.invalid
PROTEOS_COOKIE_SECURE=false

# Secrets backend. "file" until openbao-init.sh has run against the in-cluster
# OpenBao (README.md), then "openbao".
PROTEOS_SECRETS_BACKEND=file
PROTEOS_SECRETS_FILE=/var/lib/proteos/secrets.json
PROTEOS_OPENBAO_ADDR=http://proteos-openbao:8200
PROTEOS_OPENBAO_MOUNT=secret
PROTEOS_OPENBAO_PREFIX=proteos
PROTEOS_OPENBAO_ROLE_ID=
PROTEOS_OPENBAO_SECRET_ID_FILE=/run/secrets/openbao/secret-id

# The session export (TAV-141) writes to the control plane's filesystem, which
# in a pod is the data volume — the one thing the plan's K6 sketch called out.
PROTEOS_SESSION_EXPORT_DIR=/var/lib/proteos/exports/sessions

# The cluster-agent, by Service name over the pod network. Its certificate
# already names this (the SAN the README's quickstart issues), and the control
# plane pins it from the agent's own Secret (mounted by controlplane.yaml), so
# the two cannot drift. The token comes from the same Secret.
PROTEOS_NODE_AGENT_URL=https://proteos-cluster-agent.proteos-system.svc:9090
PROTEOS_NODE_CA_FILE=/etc/proteos/node-agent-ca.pem
PROTEOS_HOST_NAME=k8s
PROTEOS_HOST_DRIVER=kubernetes
# Additional hosts (Firecracker boxes, other clusters) as a JSON array — see
# .env.example in deploy/app-stack.
PROTEOS_HOSTS=

# What the synthesized "base" template boots on this host. An immutable tag or
# a digest, never :latest (deploy/kubernetes/README.md, "Image tags").
PROTEOS_IMAGE_REF=ghcr.io/tavon-ai/proteos-guest:base-CHANGE_ME
# Unset on a Kubernetes-only fleet: with no rootfs the base template is an
# image-only template, and only a kubernetes host can be given it.
PROTEOS_ROOTFS_REF=
PROTEOS_KERNEL_REF=
PROTEOS_MACHINE_VCPUS=2
PROTEOS_MACHINE_MEM_MIB=2048
PROTEOS_MACHINE_DISK_MIB=10240
PROTEOS_TEMPLATES_FILE=
PROTEOS_MAX_VCPUS=8
PROTEOS_MAX_MEM_MIB=16384
PROTEOS_MAX_DISK_MIB=51200
PROTEOS_MAX_MACHINES_PER_USER=5

# The per-machine editor/preview origin (m-<uuid>.<domain>); unset ⇒ disabled.
PROTEOS_MACHINE_DOMAIN=
PROTEOS_PROVIDERS_ENABLED=claude
ALLOWED_GITHUB_LOGINS=
GITHUB_APP_SLUG=
PROTEOS_GIT_HOST=github.com
PROTEOS_GIT_PUBLIC_HOSTS=
